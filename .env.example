# Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=supplierfeed
PGUSER=supplierfeed
PGPASSWORD=supplierfeed

# SFTP
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USERNAME=feeduser
SFTP_PASSWORD=feedpass

# Ingestion tuning
# Seconds to wait between the two stat() calls used to confirm a remote
# file isn't still mid-upload before downloading it.
SFTP_STABILITY_CHECK_INTERVAL_SECONDS=2
# Reject files whose remote mtime is older than this many hours. Leave
# blank to disable the staleness check.
SFTP_MAX_FILE_AGE_HOURS=
